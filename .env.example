# 本地 PostgreSQL；以下凭据只用于 Docker Compose 开发环境，不用于公开部署。
POSTGRES_PORT=55432
POSTGRES_SUPERUSER_PASSWORD=logiplan_local_admin
LOGIPLAN_SCHEMA_MIGRATOR_PASSWORD=logiplan_local_migrator
LOGIPLAN_DATA_PUBLISHER_PASSWORD=logiplan_local_publisher
LOGIPLAN_APP_READER_PASSWORD=logiplan_local_reader

# 供应商密钥（服务端专用，仅在 LOGIPLAN_AI_LIVE_CALLS=1 时由装配处读取；D-177 / D-193）
# 门 C 开关默认关闭：除 "1" 以外的一切取值都不装配真实适配器。
LOGIPLAN_AI_LIVE_CALLS=0
DEEPSEEK_API_KEY=
# 仅隔离评估：指向本机密钥中继，沙箱里只放中继令牌。必须为 https，默认直连官方端点。
# DEEPSEEK_BASE_URL=https://relay.example

MIGRATION_DATABASE_URL=postgresql://schema_migrator:logiplan_local_migrator@127.0.0.1:55432/logiplan
PUBLISHER_DATABASE_URL=postgresql://data_publisher:logiplan_local_publisher@127.0.0.1:55432/logiplan
DATABASE_URL=postgresql://app_reader:logiplan_local_reader@127.0.0.1:55432/logiplan

